{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chengyin.local/schemas/public-source-secret-audit-v1.schema.json",
  "title": "Chengyin public source secret audit receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "status",
    "code",
    "message",
    "recoveryAction",
    "scanScope",
    "filesVisited",
    "textFilesScanned",
    "binaryFilesSkipped",
    "bytesScanned",
    "findingCount",
    "findingsTruncated",
    "findings",
    "networkRequired",
    "environmentValuesRead",
    "privateDirectoriesScanned",
    "contentExcerptsIncluded",
    "releaseState"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "contract": {"const": "chengyin.public-source-secret-audit/v1"},
    "status": {"enum": ["PASS", "FAIL"]},
    "code": {
      "anyOf": [
        {"type": "null"},
        {"enum": [
          "SOURCE_SECRET_AUDIT_FINDINGS",
          "SOURCE_SECRET_AUDIT_INVALID_ARGUMENT",
          "SOURCE_SECRET_AUDIT_RESOURCE_LIMIT",
          "SOURCE_SECRET_AUDIT_UNREADABLE_FILE",
          "SOURCE_SECRET_AUDIT_UNSAFE_PATH",
          "SOURCE_SECRET_AUDIT_UNEXPECTED_ERROR",
          "SOURCE_SECRET_AUDIT_UNKNOWN_OPTION"
        ]}
      ]
    },
    "message": {"type": "string", "minLength": 1, "maxLength": 512},
    "recoveryAction": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 512}]},
    "scanScope": {"const": "portable-source-public-allowlist"},
    "filesVisited": {"type": "integer", "minimum": 0, "maximum": 4096},
    "textFilesScanned": {"type": "integer", "minimum": 0, "maximum": 4096},
    "binaryFilesSkipped": {"type": "integer", "minimum": 0, "maximum": 4096},
    "bytesScanned": {"type": "integer", "minimum": 0, "maximum": 67108864},
    "findingCount": {"type": "integer", "minimum": 0},
    "findingsTruncated": {"type": "boolean"},
    "findings": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "relativePath"],
        "properties": {
          "kind": {"enum": [
            "credential-assignment",
            "embedded-basic-auth",
            "embedded-private-key",
            "high-risk-credential-file",
            "known-provider-token"
          ]},
          "relativePath": {"type": "string", "minLength": 1, "maxLength": 240},
          "line": {"type": "integer", "minimum": 1}
        }
      }
    },
    "networkRequired": {"const": false},
    "environmentValuesRead": {"const": false},
    "privateDirectoriesScanned": {"const": false},
    "contentExcerptsIncluded": {"const": false},
    "releaseState": {"const": "NOT_PUBLIC_RELEASE_READY"}
  }
}
