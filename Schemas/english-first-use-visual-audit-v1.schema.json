{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chengyin.local/schemas/english-first-use-visual-audit-v1.schema.json",
  "title": "Chengyin English first-use visual audit receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "status",
    "code",
    "message",
    "recoveryAction",
    "environment",
    "locale",
    "steps",
    "runtimeAccessibility",
    "humanVoiceOverAudit",
    "physicalCleanMacAudit",
    "proofStrength",
    "releaseState"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "chengyin.english-first-use-visual-audit/v1" },
    "status": {
      "enum": ["PASS_WITH_PENDING", "FAIL"]
    },
    "code": {
      "type": ["string", "null"],
      "pattern": "^FIRST_USE_VISUAL_AUDIT_[A-Z0-9_]+$"
    },
    "message": { "type": "string", "minLength": 1, "maxLength": 500 },
    "recoveryAction": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 500
    },
    "environment": {
      "enum": ["ISOLATED_LOCAL_LAB", "SOURCE_ONLY"]
    },
    "locale": { "const": "en-US" },
    "steps": {
      "type": "array",
      "maxItems": 5,
      "items": { "$ref": "#/$defs/step" }
    },
    "runtimeAccessibility": {
      "enum": [
        "PASS",
        "PENDING_GUI_RUN",
        "PENDING_RUNTIME_ASSISTIVE_TECHNOLOGY",
        "NOT_EVALUATED"
      ]
    },
    "humanVoiceOverAudit": {
      "const": "PENDING_HUMAN_REVIEW"
    },
    "physicalCleanMacAudit": {
      "const": "PENDING_EXTERNAL_DEVICE"
    },
    "proofStrength": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "releaseState": { "const": "NOT_PUBLIC_RELEASE_READY" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "PASS_WITH_PENDING" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "code": { "type": "null" },
          "proofStrength": { "pattern": "human_review_required" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "FAIL" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "code": { "type": "string" },
          "recoveryAction": { "type": "string" }
        }
      }
    }
  ],
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "name",
        "screenshot",
        "window",
        "expectedEnglishCopy",
        "recognizedEnglishCopy",
        "accessibilityIdentifiers",
        "status"
      ],
      "properties": {
        "number": { "type": "integer", "minimum": 1, "maximum": 5 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "screenshot": {
          "type": "string",
          "pattern": "^[0-9]{2}-[a-z0-9-]+\\.png$"
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "fullyVisible"],
          "properties": {
            "width": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "height": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "fullyVisible": { "type": "boolean" }
          }
        },
        "expectedEnglishCopy": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "recognizedEnglishCopy": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "accessibilityIdentifiers": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "pattern": "^chengyin\\.[a-zA-Z0-9._-]+$"
          }
        },
        "status": { "const": "PASS" }
      }
    }
  }
}
