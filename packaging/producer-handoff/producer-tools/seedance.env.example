# Copy to seedance.env, chmod 600, and fill values locally.
# Never commit, upload, paste into a prompt, or record the real file.

export ARK_API_KEY="REPLACE_WITH_YOUR_ARK_API_KEY"
export ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"

# Only required for reference video/audio input. Use your own private TOS bucket.
export VOLCENGINE_ACCOUNT_ACCESS_KEY_ID="REPLACE_WITH_RESTRICTED_TOS_ACCESS_KEY"
export VOLCENGINE_ACCOUNT_SECRET_ACCESS_KEY="REPLACE_WITH_RESTRICTED_TOS_SECRET_KEY"
export CHENGYIN_TOS_BUCKET="REPLACE_WITH_YOUR_PRIVATE_BUCKET"
export CHENGYIN_TOS_ENDPOINT="tos-cn-beijing.volces.com"
export CHENGYIN_TOS_REGION="cn-beijing"
