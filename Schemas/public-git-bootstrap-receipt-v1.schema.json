{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chengyin.local/schemas/public-git-bootstrap-receipt-v1.schema.json",
  "title": "Chengyin audited public Git bootstrap receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "status",
    "code",
    "message",
    "recoveryAction",
    "repositoryState",
    "branch",
    "stagedFileCount",
    "commitCreated",
    "remoteConfigured",
    "destinationCreated",
    "sourcePackageIdentity",
    "sourcePackageAudit",
    "credentialAudit",
    "networkRequired",
    "authoritativeSourceMutation",
    "releaseState"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "chengyin.public-git-bootstrap/v1" },
    "status": { "enum": ["PASS", "FAIL"] },
    "code": {
      "type": ["string", "null"],
      "pattern": "^PUBLIC_GIT_BOOTSTRAP_[A-Z0-9_]+$"
    },
    "message": { "type": "string", "minLength": 1, "maxLength": 320 },
    "recoveryAction": { "type": ["string", "null"], "maxLength": 320 },
    "repositoryState": {
      "enum": ["staged-unborn-main", "not-created"]
    },
    "branch": { "type": ["string", "null"], "pattern": "^main$" },
    "stagedFileCount": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "commitCreated": { "const": false },
    "remoteConfigured": { "const": false },
    "destinationCreated": { "type": "boolean" },
    "sourcePackageIdentity": {
      "type": ["string", "null"],
      "maxLength": 160
    },
    "sourcePackageAudit": { "enum": ["PASS", "NOT_RUN"] },
    "credentialAudit": { "enum": ["PASS", "NOT_RUN"] },
    "networkRequired": { "const": false },
    "authoritativeSourceMutation": { "const": false },
    "releaseState": { "const": "NOT_PUBLIC_RELEASE_READY" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PASS" } } },
      "then": {
        "properties": {
          "code": { "const": null },
          "recoveryAction": { "const": null },
          "repositoryState": { "const": "staged-unborn-main" },
          "branch": { "const": "main" },
          "destinationCreated": { "const": true },
          "sourcePackageAudit": { "const": "PASS" },
          "credentialAudit": { "const": "PASS" }
        }
      }
    }
  ]
}
