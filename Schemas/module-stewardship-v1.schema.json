{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chengyin.example/schemas/module-stewardship-v1.schema.json",
  "title": "Chengyin module stewardship and contribution routing v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractID",
    "policyVersion",
    "identityMode",
    "roles",
    "checks",
    "modules",
    "forbiddenPathPrefixes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractID": { "const": "cc.chengyin.module-stewardship" },
    "policyVersion": { "$ref": "#/$defs/semanticVersion" },
    "identityMode": {
      "const": "role-only-until-canonical-github-organization"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/role" }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/check" }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/module" }
    },
    "forbiddenPathPrefixes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/relativePath" }
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 96
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!~)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "assignmentState", "responsibilities"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/shortText" },
        "assignmentState": {
          "enum": [
            "project-owner-boundary",
            "unassigned-until-canonical-github-organization"
          ]
        },
        "responsibilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/shortText" }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "command", "recoveryAction"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/shortText" },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "recoveryAction": { "$ref": "#/$defs/shortText" }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "pathPrefixes",
        "exactPaths",
        "reviewRoles",
        "requiredChecks",
        "riskClasses",
        "rfcPolicy",
        "ownerGatePolicy"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/shortText" },
        "pathPrefixes": {
          "type": "array",
          "maxItems": 24,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "exactPaths": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "reviewRoles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "requiredChecks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "riskClasses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "enum": [
              "accessibility",
              "documentation",
              "governance",
              "media-rights",
              "packaging",
              "privacy-security",
              "public-contract",
              "release",
              "runtime",
              "tooling"
            ]
          }
        },
        "rfcPolicy": {
          "enum": [
            "not-required",
            "required-for-public-contract-or-persistence",
            "required-for-new-permission-or-trigger",
            "required-for-policy-change"
          ]
        },
        "ownerGatePolicy": {
          "enum": [
            "none",
            "required-for-public-media-release",
            "required-for-final-license-signing-or-publication"
          ]
        }
      },
      "allOf": [
        {
          "anyOf": [
            { "properties": { "pathPrefixes": { "minItems": 1 } } },
            { "properties": { "exactPaths": { "minItems": 1 } } }
          ]
        }
      ]
    }
  }
}
